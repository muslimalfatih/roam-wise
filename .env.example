# ───────────── LLM ─────────────
# "ollama" runs a local model (default). "groq" uses Groq's hosted API for production.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Only needed when LLM_PROVIDER=groq. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ───────────── Google Maps Platform ─────────────
# Server-side key restricted to "Places API (New)". It never leaves the backend.
# https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=

# ───────────── API ─────────────
PORT=3001
# Comma-separated browser origins allowed to call the API (Open WebUI's address)
CORS_ORIGINS=http://localhost:3000
# Requests per minute allowed per client IP
RATE_LIMIT_MAX=30
# Optional. When set, POST /api/search requires "Authorization: Bearer <API_KEY>".
# Leave empty for local use; set it on any public deployment.
API_KEY=
